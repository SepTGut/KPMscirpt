{
  "name": "kpm-script",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "build": "npm --prefix apps/web run build && npm --prefix apps/mobile run build",
    "build:web": "npm --prefix apps/web run build",
    "build:mobile": "npm --prefix apps/mobile run build",
    "gas:push": "node scripts/seal_integrity.mjs && npx @google/clasp push --force",
    "gas:watch": "npx @google/clasp push --watch --force",
    "gas:pull": "npx @google/clasp pull",
    "gas:status": "npx @google/clasp status",
    "gas:deploy": "npx @google/clasp deploy",
    "gas:deployments": "npx @google/clasp deployments",
    "gas:integrity": "node scripts/seal_integrity.mjs",
    "qr:generate": "node scripts/generate_qr.mjs",
    "scan": "node scripts/deep_scan.mjs",
    "test:gps": "node scripts/test_gps.mjs",
    "test:gps:simulate": "node scripts/test_gps.mjs --simulate",
    "git:sync": "powershell -ExecutionPolicy Bypass -File scripts/git-sync.ps1",
    "deploy:netlify": "powershell -ExecutionPolicy Bypass -File apps/web/deploy-netlify.ps1",
    "deploy:vercel": "powershell -ExecutionPolicy Bypass -File apps/web/deploy-vercel.ps1",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  }
}
